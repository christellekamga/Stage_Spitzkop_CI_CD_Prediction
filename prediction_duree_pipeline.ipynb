        "    # Afficher le pourcentage avec une décimale\n",
        "    autopct='%1.1f%%',\n",
        "    startangle=90,\n",
        "    colors=['#4CAF50', '#FF5722']\n",
        ")\n",
        "plt.title('Proportion Succès vs Échec (Validation du Déséquilibre)')\n",
        "plt.show()\n",
